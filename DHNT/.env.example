# =============================================
# Flask AI API - Environment Variables
# =============================================
# Copy file này thành .env và điền thông tin thực tế
# KHÔNG commit file .env lên Git!

# Google Gemini API Key
# Lấy tại: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Configuration
FLASK_ENV=development
FLASK_PORT=5000

# Spring Boot URL (để tích hợp)
SPRING_BOOT_URL=http://localhost:8080

# Internal API Key - Flask dùng để gọi /api/ai-data/** (bảo mật server-to-server)
# PHẢI khớp với giá trị internal.api-key trong application.properties của Spring Boot
# Đặt một chuỗi ngẫu nhiên dài ≥ 32 ký tự (dùng: python -c "import secrets; print(secrets.token_hex(32))")
INTERNAL_API_KEY=your_strong_random_key_here

