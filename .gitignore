### ============================================
### .gitignore — QLCSVC AI Project (Root)
### ============================================

# ── Maven / Spring Boot ──────────────────────
HELP.md
target/
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ── Sensitive / Config ────────────────────────
# KHÔNG commit file chứa credentials lên GitHub!
DHNT/src/main/resources/application.properties
DHNT/.env
.env

# ── Uploaded files (dữ liệu người dùng) ──────
uploads/
DHNT/uploads/

# ── Logs & Temp ───────────────────────────────
*.log
*_error.log
build_output.txt
compile-errors*.txt
test_compile.txt
server_startup.log

# ── IDE: IntelliJ IDEA ───────────────────────
.idea/
*.iws
*.iml
*.ipr

# ── IDE: Spring Tool Suite (STS) ─────────────
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# ── IDE: NetBeans ────────────────────────────
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# ── IDE: VS Code ─────────────────────────────
.vscode/

# ── Python ───────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# ── Python Virtual Environments ──────────────
venv/
env/
ENV/
.venv
DHNT/venv/

# ── Flask ─────────────────────────────────────
instance/
.pytest_cache/
